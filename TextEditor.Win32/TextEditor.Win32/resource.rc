#include "resource.h"

1 24 "TextEditor.exe.manifest"

IDR_MAIN_WINDOW_MENU_MDI MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Open",                        ID_MAIN_WINDOW_MDI_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Quit",                        ID_FILE_QUIT
    END
END

IDR_MAIN_WINDOW_MENU_SDI MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Open",                        ID_MAIN_WINDOW_SDI_FILE_OPEN
        MENUITEM "Save",                        ID_MAIN_WINDOW_SDI_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Quit",                        ID_FILE_QUIT
    END
END

IDR_TEXTBOX_MENU_MDI MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Save",                        ID_TEXTBOX_MDI_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "Close",                       ID_TEXTBOX_MDI_FILE_CLOSE
    END
END